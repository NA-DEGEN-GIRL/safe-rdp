<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.na_degen_girl.saferdp">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Asked for only when a key is set to need it, before connecting. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Lets the session screen hide other apps' overlay windows (Android 12+). -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
    <!-- Only to read a key's QR code; asked for when that is chosen. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- For SessionService: a session left for a moment is not cut off by the app being frozen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- To offer opening the Tailscale app when its VPN is off. -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/icon"
        android:theme="@style/Theme.App"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/no_backup"
        android:extractNativeLibs="false"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not recreated on rotation, folding, a keyboard or mouse coming and going: the session
             and its surface carry on. -->
        <activity
            android:name=".SessionActivity"
            android:exported="false"
            android:theme="@style/Theme.Session"
            android:windowSoftInputMode="stateAlwaysHidden|adjustNothing"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode|touchscreen|colorMode|fontScale|layoutDirection|locale|mcc|mnc"
            android:excludeFromRecents="false"
            android:launchMode="singleTask" />

        <activity
            android:name=".KeysActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden" />

        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:theme="@style/Theme.Session"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden" />

        <service
            android:name=".SessionService"
            android:exported="false"
            android:foregroundServiceType="shortService" />
    </application>
</manifest>
